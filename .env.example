# =============================================================================
# GenFlows SEO Automation — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================


# ── Server ────────────────────────────────────────────────────────────────────

# Port the Express API listens on (default: 8787)
PORT=8787

# SQLite database file path (relative to repo root or absolute)
DATABASE_PATH=./data/app.db

# Directory for uploaded company documents (PDFs, etc.)
UPLOAD_DIR=./server/uploads


# ── Anthropic / Claude (required for all AI features) ────────────────────────
# Use ONE of the two options below. If both are set, OAuth token wins.

# Option A — API key (get one at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Option B — OAuth subscription token (Claude Max / Claude Code users)
# ANTHROPIC_AUTH_TOKEN=


# ── Claude model overrides (optional) ────────────────────────────────────────
# Defaults to claude-opus-4-8 for all stages.
# Swap in claude-sonnet-4-6 for faster/cheaper generation.

# ANTHROPIC_MODEL_DEFAULT=claude-opus-4-8
# ANTHROPIC_MODEL_BLOG=claude-opus-4-8
# ANTHROPIC_MODEL_PLAGIARISM=claude-opus-4-8


# ── SerpAPI (required for SERP research & keyword features) ──────────────────
# Get your key at serpapi.com
SERPAPI_KEY=


# ── Autoresearch tuning (optional) ───────────────────────────────────────────
# Number of scoring rounds per autoresearch run (default: 3)
# AUTORESEARCH_DEFAULT_ROUNDS=3

# Topic candidates generated per round (default: 8)
# AUTORESEARCH_CANDIDATES_PER_ROUND=8

# Default autopilot posts per week per company (default: 3)
# AUTOPILOT_DEFAULT_CADENCE=3


# ── HubSpot (not yet wired — add integration here) ───────────────────────────
# Private App token (Settings → Integrations → Private Apps)
# Needs scopes: content (read/write), hubdb (if using HubDB)
HUBSPOT_ACCESS_TOKEN=

# HubSpot portal / account ID (shown in the top-right of your HubSpot account)
HUBSPOT_PORTAL_ID=

# Blog content type ID to publish under (find via HubSpot API or Settings → Website → Blog)
# HUBSPOT_BLOG_ID=


# ── Future integrations (uncomment when adding) ───────────────────────────────

# WordPress REST API
# WORDPRESS_URL=https://yourdomain.com
# WORDPRESS_USER=admin
# WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Webflow (CMS Collections API)
# WEBFLOW_API_TOKEN=
# WEBFLOW_SITE_ID=
# WEBFLOW_COLLECTION_ID=

# Slack notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# OpenAI (if adding image generation or embeddings)
# OPENAI_API_KEY=sk-...
